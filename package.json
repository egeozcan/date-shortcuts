{
  "name": "date-shortcut-parser",
  "version": "1.0.3",
  "description": "A lightweight and powerful TypeScript library for parsing human-readable date shortcuts into `Date` objects.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/egeozcan/date-shortcuts#readme",
  "bugs": {
    "url": "https://github.com/egeozcan/date-shortcuts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egeozcan/date-shortcuts.git"
  },
  "author": "Yavuz Ege Özcan",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "date",
    "time",
    "parser",
    "shortcut",
    "datetime",
    "natural language",
    "date-parsing",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:dist": "node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit",
    "release": "bumpp && npm publish"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "bumpp": "^10.1.0",
    "tsdown": "^0.11.9",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
